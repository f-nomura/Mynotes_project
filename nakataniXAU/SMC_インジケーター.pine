//@version=6
indicator("SMC Indicator (ZigZag + ICT HP PRO)", overlay=true, max_bars_back=5000, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// --- Inputs ---
int prd = input.int(5, title="ZigZag Period", minval=2, maxval=50)
bool showzigzag = input.bool(true, title="Show Zig Zag")
color upcol = input.color(color.lime, title="Zigzag Colors", inline="zzcol")
color dncol = input.color(color.red, title="", inline="zzcol")

bool showfibo = input.bool(false, title="Show Fibonacci Ratios")
color labelcol = input.color(color.blue, title="Text Color for Fibo Levels")
color fibolinecol = input.color(color.lime, title="Line Color for Fibo Levels")
string labelloc = input.string("Left", title="Label Location", options=["Left", "Right"])
bool enable236 = input.bool(true, title="Enable Level 0.236")
bool enable382 = input.bool(true, title="Enable Level 0.382")
bool enable500 = input.bool(true, title="Enable Level 0.500")
bool enable618 = input.bool(true, title="Enable Level 0.618")
bool enable786 = input.bool(true, title="Enable Level 0.786")

// --- CRT Sweep ---
bool show_crt_sweep = input.bool(true, title="Show CRT Sweep")
int crt_lookback = input.int(20, title="CRT Sweep Lookback", minval=2, maxval=200)
bool show_crt_1h_range = input.bool(true, title="Show Last 1H CRT Range")
color crt_1h_high_col = input.color(color.new(#636363, 0), title="1H CRT High Color")
color crt_1h_low_col = input.color(color.new(#636363, 0), title="1H CRT Low Color")
bool show_crt_4h_range = input.bool(true, title="Show Last 4H CRT Range")
color crt_4h_high_col = input.color(color.new(#636363, 0), title="4H CRT High Color")
color crt_4h_low_col = input.color(color.new(#636363, 0), title="4H CRT Low Color")
bool show_crt_debug = input.bool(false, title="Show CRT Debug Info")

// --- HTF Mini Candles ---
bool show_htf_mini = input.bool(true, title="Show HTF Mini Candles")
int htf_candle_count = input.int(3, title="HTF Candle Count", minval=3, maxval=3)

// ATR used by Supply/Demand zones
float atr = ta.atr(20)

fmt_time(int t) => str.tostring(t)

// --- Supply / Demand Zones ---
bool show_supply_demand = input.bool(true, title="Show Supply/Demand Zones")
int sd_swingLen = input.int(12, "Swing Length (Sensitivity)", minval=3, maxval=50, tooltip="Higher = Less zones, more significant", group="Supply/Demand Zone Detection")
int sd_maxZones = input.int(10, "Max Zones to Display", minval=3, maxval=30, group="Supply/Demand Zone Detection")
float sd_maxZoneHeightATR = input.float(1.0, "Max Zone Height (ATR Multiplier)", minval=0.5, maxval=10.0, step=0.5, tooltip="Zones larger than this will be clamped", group="Supply/Demand Zone Detection")
float sd_minZoneHeightATR = input.float(1.0, "Min Zone Height (ATR Multiplier)", minval=0.1, maxval=2.0, step=0.1, tooltip="Zones smaller than this will be rejected", group="Supply/Demand Zone Detection")
float sd_forceZoneHeightATR = input.float(1.0, "Force Zone Height (ATR Multiplier)", minval=0.2, maxval=3.0, step=0.1, tooltip="All zones will be expanded to at least this height", group="Supply/Demand Zone Detection")
int sd_minZoneDistance = input.int(44, "Min Distance Between Zones (bars)", minval=1, maxval=100, group="Supply/Demand Zone Detection")

string sd_invalidationMethod = input.string("Close", "Zone Invalidation", options=["Close", "Wick"], group="Supply/Demand Zone Settings")
bool sd_showHistoric = input.bool(false, "Show Historic Zones", group="Supply/Demand Zone Settings")
int sd_activeLookback = input.int(1000, "Active Zones Lookback", minval=100, maxval=5000, group="Supply/Demand Zone Settings")
int sd_historicBars = input.int(1000, "Historic Zones Lookback", minval=100, maxval=5000, group="Supply/Demand Zone Settings")

bool sd_showActiveLabels = input.bool(true, "Show Active Zone Info", group="Supply/Demand Display")
bool sd_showHistoricLabels = input.bool(false, "Show Historic Zone Info", group="Supply/Demand Display")
string sd_labelSize = input.string("Large", "Label Size", options=["Tiny", "Small", "Normal", "Large"], group="Supply/Demand Display")

color sd_activeSupplyCol = input.color(color.new(color.red, 90), "Active Supply", group="Supply/Demand Colors")
color sd_activeDemandCol = input.color(color.new(color.green, 90), "Active Demand", group="Supply/Demand Colors")
color sd_historicCol = input.color(color.new(color.gray, 90), "Historic Zones", group="Supply/Demand Colors")

bool sd_showRetestMarkers = input.bool(true, "Show Retests", group="Supply/Demand Retests")
color sd_retestBullCol = input.color(color.new(color.green, 0), "Demand Retest", group="Supply/Demand Retests")
color sd_retestBearCol = input.color(color.new(color.red, 0), "Supply Retest", group="Supply/Demand Retests")

bool sd_alertsOn = input.bool(true, "Enable Alerts", group="Supply/Demand Alerts")

// --- ZigZag Type Definition ---
type ZigZag
    int prd
    array<float> points
    array<float> old_points
    int dir
    int max_array_size
    color up_color
    color dn_color
    line zz_line

// Constructor method
method init(ZigZag this, int _prd, color _up_color, color _dn_color) =>
    this.prd := _prd
    this.up_color := _up_color
    this.dn_color := _dn_color
    this.points := array.new_float()
    this.old_points := array.new_float()
    this.max_array_size := 10
    this.dir := 0
    this.zz_line := na

// Method to update ZigZag points
method update(ZigZag this) =>
    this.old_points := this.points.copy()
    float ph = ta.highestbars(high, this.prd) == 0 ? high : na
    float pl = ta.lowestbars(low, this.prd) == 0 ? low : na
    int prev_dir = this.dir
    this.dir := not na(ph) and na(pl) ? 1 : not na(pl) and na(ph) ? -1 : this.dir

    bool dirchanged = this.dir != prev_dir
    if not na(ph) or not na(pl)
        float point_value = this.dir == 1 ? ph : pl
        if dirchanged
            this.points.unshift(bar_index)
            this.points.unshift(point_value)
            if this.points.size() > this.max_array_size
                this.points.pop()
                this.points.pop()
        if not dirchanged
            if this.points.size() == 0
                this.points.unshift(bar_index)
                this.points.unshift(point_value)
                if this.points.size() > this.max_array_size
                    this.points.pop()
                    this.points.pop()
            if this.points.size() > 0 and ((this.dir == 1 and point_value > this.points.get(0)) or (this.dir == -1 and point_value < this.points.get(0)))
                this.points.set(0, point_value)
                this.points.set(1, bar_index)

// Method to draw the ZigZag line
method draw(ZigZag this) =>
    if this.points.size() >= 4 and this.old_points.size() >= 4
        if this.points.get(0) != this.old_points.get(0) or this.points.get(1) != this.old_points.get(1)
            if this.points.get(2) == this.old_points.get(2) and this.points.get(3) == math.round(this.old_points.get(3))
                if not na(this.zz_line)
                    this.zz_line.delete()
            this.zz_line := line.new(x1=int(math.round(this.points.get(1))), y1=this.points.get(0), x2=int(math.round(this.points.get(3))), y2=this.points.get(2), color=this.dir == 1 ? this.up_color : this.dn_color, width=2)

// --- Fibonacci Type Definition ---
type Fibonacci
    array<float> ratios
    int shown_levels
    array<line> lines
    array<label> labels
    color line_color
    color text_color
    string label_loc

// Constructor method
method init(Fibonacci this, bool _e236, bool _e382, bool _e500, bool _e618, bool _e786, color _lcol, color _tcol, string _lloc) =>
    this.line_color := _lcol
    this.text_color := _tcol
    this.label_loc := _lloc
    this.ratios := array.new_float()
    this.lines := array.new_line()
    this.labels := array.new_label()
    this.shown_levels := 1
    this.ratios.push(0.0)
    if _e236
        this.ratios.push(0.236)
        this.shown_levels += 1
    if _e382
        this.ratios.push(0.382)
        this.shown_levels += 1
    if _e500
        this.ratios.push(0.500)
        this.shown_levels += 1
    if _e618
        this.ratios.push(0.618)
        this.shown_levels += 1
    if _e786
        this.ratios.push(0.786)
        this.shown_levels += 1
    for x = 1 to 5
        this.ratios.push(x)
        this.ratios.push(x + 0.272)
        this.ratios.push(x + 0.414)
        this.ratios.push(x + 0.618)

// Method to draw Fibonacci levels
method draw(Fibonacci this, array<float> zigzag_points, int dir) =>
    if this.lines.size() > 0
        for i = 0 to this.lines.size() - 1
            this.lines.get(i).delete()
            this.labels.get(i).delete()
    this.lines.clear()
    this.labels.clear()
    if zigzag_points.size() >= 6
        float diff = zigzag_points.get(4) - zigzag_points.get(2)
        bool stopit = false
        for x = 0 to this.ratios.size() - 1
            if stopit and x > this.shown_levels
                break
            float y_level = zigzag_points.get(2) + diff * this.ratios.get(x)
            this.lines.unshift(line.new(x1=int(math.round(zigzag_points.get(5))), y1=y_level, x2=bar_index, y2=y_level, color=this.line_color, extend=extend.right))
            int label_x_loc = this.label_loc == "Left" ? int(math.round(zigzag_points.get(5))) - 1 : bar_index + 15
            string label_text = str.format("{0,number,#.###}({1})", this.ratios.get(x), str.format("{0,number}", math.round_to_mintick(y_level)))
            this.labels.unshift(label.new(x=label_x_loc, y=y_level, text=label_text, textcolor=this.text_color, style=label.style_none))
            if (dir == 1 and y_level > zigzag_points.get(0)) or (dir == -1 and y_level < zigzag_points.get(0))
                stopit := true

// --- Main Script Logic ---

// Initialize objects on the first bar
var zz = ZigZag.new()
var fibo = Fibonacci.new()
if barstate.isfirst
    zz.init(prd, upcol, dncol)
    fibo.init(enable236, enable382, enable500, enable618, enable786, fibolinecol, labelcol, labelloc)

// Update ZigZag on every bar
zz.update()

// Draw ZigZag if enabled
if showzigzag
    zz.draw()

// Draw Fibonacci levels on the last bar if enabled
if showfibo and barstate.islast
    fibo.draw(zz.points, zz.dir)

float crt_low_ref = ta.lowest(low, crt_lookback)[1]
float crt_high_ref = ta.highest(high, crt_lookback)[1]
bool crt_low_sweep = show_crt_sweep and not na(crt_low_ref) and low < crt_low_ref and close > crt_low_ref
bool crt_high_sweep = show_crt_sweep and not na(crt_high_ref) and high > crt_high_ref and close < crt_high_ref

plotshape(crt_low_sweep, title="CRT Low Sweep", style=shape.labelup, location=location.belowbar, color=color.new(#9affbc, 0), text="CRT Low\nSweep", textcolor=color.black, size=size.tiny)
plotshape(crt_high_sweep, title="CRT High Sweep", style=shape.labeldown, location=location.abovebar, color=color.new(#ffa6a6, 0), text="CRT High\nSweep", textcolor=color.black, size=size.tiny)

[crt1h_prev_high, crt1h_prev_low, crt1h_sweep_high, crt1h_sweep_low, crt1h_high_sweep, crt1h_low_sweep, crt1h_prev_time, crt1h_sweep_time] = request.security(syminfo.tickerid, "60", [
    high[1],
    low[1],
    high,
    low,
    high > high[1] and close < high[1],
    low < low[1] and close > low[1],
    time[1],
    time
], lookahead=barmerge.lookahead_off)

var line crt1h_high_line = na
var line crt1h_low_line = na
var label crt1h_high_label = na
var label crt1h_low_label = na
var float crt1h_last_high = na
var float crt1h_last_low = na
var int crt1h_last_sweep_time = na
var int crt1h_last_source_time = na

int crt1h_sweep_dir = crt1h_high_sweep ? 1 : crt1h_low_sweep ? -1 : 0
if show_crt_1h_range and crt1h_sweep_dir != 0 and (na(crt1h_last_sweep_time) or crt1h_sweep_time != crt1h_last_sweep_time)
    crt1h_last_sweep_time := crt1h_sweep_time
    crt1h_last_source_time := crt1h_prev_time
    crt1h_last_high := crt1h_prev_high
    crt1h_last_low := crt1h_prev_low

if show_crt_1h_range and barstate.islast and not na(crt1h_last_high) and not na(crt1h_last_low)
    if not na(crt1h_high_line)
        line.delete(crt1h_high_line)
    if not na(crt1h_low_line)
        line.delete(crt1h_low_line)
    if not na(crt1h_high_label)
        label.delete(crt1h_high_label)
    if not na(crt1h_low_label)
        label.delete(crt1h_low_label)

    crt1h_high_line := line.new(x1=crt1h_last_source_time, y1=crt1h_last_high, x2=crt1h_sweep_time, y2=crt1h_last_high, xloc=xloc.bar_time, color=crt_1h_high_col, style=line.style_dashed, width=2)
    crt1h_low_line := line.new(x1=crt1h_last_source_time, y1=crt1h_last_low, x2=crt1h_sweep_time, y2=crt1h_last_low, xloc=xloc.bar_time, color=crt_1h_low_col, style=line.style_dashed, width=2)
    string crt1h_dir_text = crt1h_high_sweep ? "HIGH SWEEP" : crt1h_low_sweep ? "LOW SWEEP" : "N/A"
    string crt1h_high_text = show_crt_debug ? ("CRT HIGH 1H\n" + crt1h_dir_text + "\nsource H/L: " + str.tostring(crt1h_prev_high, format.mintick) + " / " + str.tostring(crt1h_prev_low, format.mintick) + "\nsweep H/L: " + str.tostring(crt1h_sweep_high, format.mintick) + " / " + str.tostring(crt1h_sweep_low, format.mintick)) : "CRT HIGH"
    string crt1h_low_text = show_crt_debug ? ("CRT LOW 1H\n" + crt1h_dir_text + "\nsource H/L: " + str.tostring(crt1h_prev_high, format.mintick) + " / " + str.tostring(crt1h_prev_low, format.mintick) + "\nsweep H/L: " + str.tostring(crt1h_sweep_high, format.mintick) + " / " + str.tostring(crt1h_sweep_low, format.mintick)) : "CRT LOW"
    crt1h_high_label := label.new(x=crt1h_sweep_time, y=crt1h_last_high, text=crt1h_high_text, xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=crt_1h_high_col, style=label.style_label_left, size=size.tiny)
    crt1h_low_label := label.new(x=crt1h_sweep_time, y=crt1h_last_low, text=crt1h_low_text, xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=crt_1h_low_col, style=label.style_label_left, size=size.tiny)

[crt4h_prev_high, crt4h_prev_low, crt4h_sweep_high, crt4h_sweep_low, crt4h_high_sweep, crt4h_low_sweep, crt4h_prev_time, crt4h_sweep_time] = request.security(syminfo.tickerid, "240", [
    high[1],
    low[1],
    high,
    low,
    high > high[1] and close < high[1],
    low < low[1] and close > low[1],
    time[1],
    time
], lookahead=barmerge.lookahead_off)

var line crt4h_high_line = na
var line crt4h_low_line = na
var label crt4h_high_label = na
var label crt4h_low_label = na
var float crt4h_last_high = na
var float crt4h_last_low = na
var int crt4h_last_sweep_time = na
var int crt4h_last_source_time = na

int crt4h_sweep_dir = crt4h_high_sweep ? 1 : crt4h_low_sweep ? -1 : 0
if show_crt_4h_range and crt4h_sweep_dir != 0 and (na(crt4h_last_sweep_time) or crt4h_sweep_time != crt4h_last_sweep_time)
    crt4h_last_sweep_time := crt4h_sweep_time
    crt4h_last_source_time := crt4h_prev_time
    crt4h_last_high := crt4h_prev_high
    crt4h_last_low := crt4h_prev_low

if show_crt_4h_range and barstate.islast and not na(crt4h_last_high) and not na(crt4h_last_low)
    if not na(crt4h_high_line)
        line.delete(crt4h_high_line)
    if not na(crt4h_low_line)
        line.delete(crt4h_low_line)
    if not na(crt4h_high_label)
        label.delete(crt4h_high_label)
    if not na(crt4h_low_label)
        label.delete(crt4h_low_label)

    crt4h_high_line := line.new(x1=crt4h_last_source_time, y1=crt4h_last_high, x2=crt4h_sweep_time, y2=crt4h_last_high, xloc=xloc.bar_time, color=crt_4h_high_col, style=line.style_dashed, width=2)
    crt4h_low_line := line.new(x1=crt4h_last_source_time, y1=crt4h_last_low, x2=crt4h_sweep_time, y2=crt4h_last_low, xloc=xloc.bar_time, color=crt_4h_low_col, style=line.style_dashed, width=2)
    string crt4h_dir_text = crt4h_high_sweep ? "HIGH SWEEP" : crt4h_low_sweep ? "LOW SWEEP" : "N/A"
    string crt4h_high_text = show_crt_debug ? ("CRT HIGH 4H\n" + crt4h_dir_text + "\nsource H/L: " + str.tostring(crt4h_prev_high, format.mintick) + " / " + str.tostring(crt4h_prev_low, format.mintick) + "\nsweep H/L: " + str.tostring(crt4h_sweep_high, format.mintick) + " / " + str.tostring(crt4h_sweep_low, format.mintick)) : "CRT HIGH 4H"
    string crt4h_low_text = show_crt_debug ? ("CRT LOW 4H\n" + crt4h_dir_text + "\nsource H/L: " + str.tostring(crt4h_prev_high, format.mintick) + " / " + str.tostring(crt4h_prev_low, format.mintick) + "\nsweep H/L: " + str.tostring(crt4h_sweep_high, format.mintick) + " / " + str.tostring(crt4h_sweep_low, format.mintick)) : "CRT LOW 4H"
    crt4h_high_label := label.new(x=crt4h_sweep_time, y=crt4h_last_high, text=crt4h_high_text, xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=crt_4h_high_col, style=label.style_label_left, size=size.tiny)
    crt4h_low_label := label.new(x=crt4h_sweep_time, y=crt4h_last_low, text=crt4h_low_text, xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=crt_4h_low_col, style=label.style_label_left, size=size.tiny)

// --- HTF Mini Candle Renderer ---
var array<line> htf_wicks = array.new_line()
var array<box> htf_bodies = array.new_box()
var array<label> htf_labels = array.new_label()

clear_htf_drawings() =>
    if htf_wicks.size() > 0
        for i = 0 to htf_wicks.size() - 1
            htf_wicks.get(i).delete()
    if htf_bodies.size() > 0
        for i = 0 to htf_bodies.size() - 1
            htf_bodies.get(i).delete()
    if htf_labels.size() > 0
        for i = 0 to htf_labels.size() - 1
            htf_labels.get(i).delete()
    htf_wicks.clear()
    htf_bodies.clear()
    htf_labels.clear()

scale_to_panel(float p, float p_min, float p_max, float panel_bottom, float panel_height) =>
    float src_range = math.max(p_max - p_min, syminfo.mintick)
    panel_bottom + ((p - p_min) / src_range) * panel_height

draw_mini_candle(int left_x, float o, float h, float l, float c, float tf_min, float tf_max, float panel_bottom, float panel_height) =>
    float yo = scale_to_panel(o, tf_min, tf_max, panel_bottom, panel_height)
    float yh = scale_to_panel(h, tf_min, tf_max, panel_bottom, panel_height)
    float yl = scale_to_panel(l, tf_min, tf_max, panel_bottom, panel_height)
    float yc = scale_to_panel(c, tf_min, tf_max, panel_bottom, panel_height)
    int right_x = left_x + 2
    int mid_x = left_x + 1
    color ccol = c >= o ? color.new(color.lime, 0) : color.new(color.red, 0)
    color bcol = c >= o ? color.new(color.lime, 70) : color.new(color.red, 70)
    htf_wicks.push(line.new(x1=mid_x, y1=yl, x2=mid_x, y2=yh, xloc=xloc.bar_index, extend=extend.none, color=ccol, width=1))
    htf_bodies.push(box.new(left=left_x, top=math.max(yo, yc), right=right_x, bottom=math.min(yo, yc), xloc=xloc.bar_index, bgcolor=bcol, border_color=ccol))

draw_tf_group(string tf_label, int x_start, float tf_max, float tf_min,
     float o1, float h1, float l1, float c1,
     float o2, float h2, float l2, float c2,
     float o3, float h3, float l3, float c3,
     bool low_sweep, bool high_sweep,
     float panel_bottom, float panel_height) =>
    draw_mini_candle(x_start, o1, h1, l1, c1, tf_min, tf_max, panel_bottom, panel_height)
    draw_mini_candle(x_start + 3, o2, h2, l2, c2, tf_min, tf_max, panel_bottom, panel_height)
    draw_mini_candle(x_start + 6, o3, h3, l3, c3, tf_min, tf_max, panel_bottom, panel_height)
    htf_labels.push(label.new(x=x_start + 3, y=panel_bottom + panel_height * 1.08, text=tf_label, xloc=xloc.bar_index, style=label.style_label_down, textcolor=color.white, color=color.new(color.black, 60), size=size.tiny))
    if low_sweep
        htf_labels.push(label.new(x=x_start + 4, y=panel_bottom - panel_height * 0.02, text="CRT Low Sweep", xloc=xloc.bar_index, style=label.style_label_up, textcolor=color.black, color=color.new(color.aqua, 0), size=size.tiny))
    if high_sweep
        htf_labels.push(label.new(x=x_start + 4, y=panel_bottom + panel_height * 0.98, text="CRT High Sweep", xloc=xloc.bar_index, style=label.style_label_down, textcolor=color.black, color=color.new(color.orange, 0), size=size.tiny))

// --- Supply / Demand Object Engine ---
f_sdGetPips() =>
    syminfo.type == "forex" ? (syminfo.currency == "JPY" ? 0.01 : 0.0001) : (syminfo.ticker == "XAUUSD" or syminfo.ticker == "GOLD") ? 0.1 : 0.0001

f_sdToPips(val) =>
    math.abs(val) / f_sdGetPips()

f_sdGetSession() =>
    h = hour(time, syminfo.timezone)
    h >= 0 and h < 9 ? "Asian" : h >= 8 and h < 13 ? "London" : h >= 13 and h < 22 ? "New York" : "Other"

f_sdGetLabelSize() =>
    sd_labelSize == "Tiny" ? size.tiny : sd_labelSize == "Small" ? size.small : sd_labelSize == "Normal" ? size.normal : size.large

f_sdCalcStrength(retests, age) =>
    score = 8.0 - (retests * 0.8) - math.min(age / 500.0, 2.0)
    int(math.max(0, math.min(10, score)))

f_sdGetLabelColor(zoneType, broken) =>
    if broken
        color.new(color.gray, 0)
    else
        zoneType == "Supply" ? color.new(color.red, 0) : color.new(color.green, 0)

type ZoneData
    box zoneBox
    label infoLabel
    label retestLabel
    float top
    float bottom
    int startBar
    string session
    int retests
    bool broken
    string zoneType
    bool retestCounted

type ZoneEngine
    array<ZoneData> zones
    int lastSupplyBar
    int lastDemandBar
    int swingLen
    int maxZones
    float maxZoneHeightATR
    float minZoneHeightATR
    float forceZoneHeightATR
    int minZoneDistance
    string invalidationMethod
    bool showHistoric
    int activeLookback
    int historicBars
    bool showActiveLabels
    bool showHistoricLabels
    color activeSupplyCol
    color activeDemandCol
    color historicCol
    bool showRetestMarkers
    color retestBullCol
    color retestBearCol

method init(ZoneEngine this, int _swingLen, int _maxZones, float _maxZoneHeightATR, float _minZoneHeightATR, float _forceZoneHeightATR, int _minZoneDistance, string _invalidationMethod, bool _showHistoric, int _activeLookback, int _historicBars, bool _showActiveLabels, bool _showHistoricLabels, color _activeSupplyCol, color _activeDemandCol, color _historicCol, bool _showRetestMarkers, color _retestBullCol, color _retestBearCol) =>
    this.zones := array.new<ZoneData>()
    this.lastSupplyBar := 0
    this.lastDemandBar := 0
    this.swingLen := _swingLen
    this.maxZones := _maxZones
    this.maxZoneHeightATR := _maxZoneHeightATR
    this.minZoneHeightATR := _minZoneHeightATR
    this.forceZoneHeightATR := _forceZoneHeightATR
    this.minZoneDistance := _minZoneDistance
    this.invalidationMethod := _invalidationMethod
    this.showHistoric := _showHistoric
    this.activeLookback := _activeLookback
    this.historicBars := _historicBars
    this.showActiveLabels := _showActiveLabels
    this.showHistoricLabels := _showHistoricLabels
    this.activeSupplyCol := _activeSupplyCol
    this.activeDemandCol := _activeDemandCol
    this.historicCol := _historicCol
    this.showRetestMarkers := _showRetestMarkers
    this.retestBullCol := _retestBullCol
    this.retestBearCol := _retestBearCol

method hideInfoLabel(ZoneData this) =>
    if not na(this.infoLabel)
        label.set_color(this.infoLabel, color.new(color.black, 100))
        label.set_textcolor(this.infoLabel, color.new(color.white, 100))

method hideRetestLabel(ZoneData this) =>
    if not na(this.retestLabel)
        label.set_color(this.retestLabel, color.new(color.white, 100))
        label.set_textcolor(this.retestLabel, color.new(color.white, 100))

method hideVisuals(ZoneData this) =>
    box.set_bgcolor(this.zoneBox, color.new(color.gray, 100))
    box.set_border_color(this.zoneBox, color.new(color.gray, 100))
    this.hideInfoLabel()
    this.hideRetestLabel()

method showZoneColor(ZoneData this, color zoneCol) =>
    box.set_bgcolor(this.zoneBox, zoneCol)

method setHistoricColor(ZoneData this, color zoneCol) =>
    box.set_bgcolor(this.zoneBox, zoneCol)

method syncInfoLabel(ZoneData this, bool showThisLabel) =>
    if showThisLabel
        heightPips = f_sdToPips(this.top - this.bottom)
        distPips = this.zoneType == "Supply" ? f_sdToPips(this.bottom - close) : f_sdToPips(close - this.top)
        strength = f_sdCalcStrength(this.retests, bar_index - this.startBar)
        txt = str.format("{0,number,#} pips || {1} || Strength {2}/10 || {3} || {4} bars || {5,number,#} pips away", heightPips, this.zoneType, strength, this.session, bar_index - this.startBar, math.abs(distPips))
        mid = (this.top + this.bottom) / 2
        lblColor = f_sdGetLabelColor(this.zoneType, this.broken)
        if na(this.infoLabel)
            this.infoLabel := label.new(this.startBar + 10, mid, txt, color=color.new(color.black, 100), textcolor=lblColor, size=f_sdGetLabelSize(), style=label.style_label_left)
            0
        else
            label.set_text(this.infoLabel, txt)
            label.set_y(this.infoLabel, mid)
            label.set_color(this.infoLabel, color.new(color.black, 100))
            label.set_textcolor(this.infoLabel, lblColor)
            label.set_size(this.infoLabel, f_sdGetLabelSize())
            label.set_style(this.infoLabel, label.style_label_left)
            label.set_x(this.infoLabel, this.startBar + 10)
            0
    else
        this.hideInfoLabel()
        0

method syncRetestLabel(ZoneData this) =>
    if sd_showRetestMarkers and this.retests > 0
        if na(this.retestLabel)
            if this.zoneType == "Supply"
                this.retestLabel := label.new(this.startBar + 3, this.top, "R", color=sd_retestBearCol, textcolor=color.white, size=size.small, style=label.style_label_down)
                0
            else
                this.retestLabel := label.new(this.startBar + 3, this.bottom, "R", color=sd_retestBullCol, textcolor=color.white, size=size.small, style=label.style_label_up)
                0
        else
            retestCol = this.zoneType == "Supply" ? sd_retestBearCol : sd_retestBullCol
            label.set_color(this.retestLabel, retestCol)
            label.set_textcolor(this.retestLabel, color.white)
            label.set_x(this.retestLabel, this.startBar + 3)
            label.set_y(this.retestLabel, this.zoneType == "Supply" ? this.top : this.bottom)
            0
    else
        this.hideRetestLabel()
        0

method createZone(ZoneEngine this, string zoneType, float zoneTopInput, float zoneBotInput, int startBar, string sess, float atrValue, int currentBar) =>
    float zoneTop = zoneTopInput
    float zoneBot = zoneBotInput
    if zoneType == "Supply"
        if currentBar - this.lastSupplyBar >= this.minZoneDistance
            mid = (zoneTop + zoneBot) / 2
            zoneHeight = zoneTop - zoneBot
            if zoneHeight < atrValue * this.forceZoneHeightATR
                forcedHeight = atrValue * this.forceZoneHeightATR
                zoneTop := mid + (forcedHeight / 2)
                zoneBot := mid - (forcedHeight / 2)
                zoneHeight := forcedHeight
            if zoneHeight > atrValue * this.maxZoneHeightATR
                maxHeight = atrValue * this.maxZoneHeightATR
                zoneTop := mid + (maxHeight / 2)
                zoneBot := mid - (maxHeight / 2)
                zoneHeight := maxHeight
            if zoneHeight >= atrValue * this.minZoneHeightATR
                mergedWithExisting = false
                if array.size(this.zones) > 0
                    for i = array.size(this.zones) - 1 to math.max(0, array.size(this.zones) - 10)
                        z = array.get(this.zones, i)
                        if z.zoneType == "Supply" and not z.broken
                            zonesOverlap = zoneTop >= z.bottom and zoneBot <= z.top
                            if zonesOverlap
                                newTop = math.max(zoneTop, z.top)
                                newBot = math.min(zoneBot, z.bottom)
                                z.top := newTop
                                z.bottom := newBot
                                box.set_top(z.zoneBox, newTop)
                                box.set_bottom(z.zoneBox, newBot)
                                array.set(this.zones, i, z)
                                mergedWithExisting := true
                                break
                if not mergedWithExisting
                    zoneBox = box.new(left=startBar, top=zoneTop, right=currentBar + 400, bottom=zoneBot, bgcolor=this.activeSupplyCol, border_width=0)
                    zoneData = ZoneData.new(zoneBox, na, na, zoneTop, zoneBot, startBar, sess, 0, false, "Supply", false)
                    array.push(this.zones, zoneData)
                    this.lastSupplyBar := currentBar
                    if array.size(this.zones) > this.maxZones * 4
                        array.shift(this.zones)
    else
        if currentBar - this.lastDemandBar >= this.minZoneDistance
            mid = (zoneTop + zoneBot) / 2
            zoneHeight = zoneTop - zoneBot
            if zoneHeight < atrValue * this.forceZoneHeightATR
                forcedHeight = atrValue * this.forceZoneHeightATR
                zoneTop := mid + (forcedHeight / 2)
                zoneBot := mid - (forcedHeight / 2)
                zoneHeight := forcedHeight
            if zoneHeight > atrValue * this.maxZoneHeightATR
                maxHeight = atrValue * this.maxZoneHeightATR
                zoneTop := mid + (maxHeight / 2)
                zoneBot := mid - (maxHeight / 2)
                zoneHeight := maxHeight
            if zoneHeight >= atrValue * this.minZoneHeightATR
                mergedWithExisting = false
                if array.size(this.zones) > 0
                    for i = array.size(this.zones) - 1 to math.max(0, array.size(this.zones) - 10)
                        z = array.get(this.zones, i)
                        if z.zoneType == "Demand" and not z.broken
                            zonesOverlap = zoneTop >= z.bottom and zoneBot <= z.top
                            if zonesOverlap
                                newTop = math.max(zoneTop, z.top)
                                newBot = math.min(zoneBot, z.bottom)
                                z.top := newTop
                                z.bottom := newBot
                                box.set_top(z.zoneBox, newTop)
                                box.set_bottom(z.zoneBox, newBot)
                                array.set(this.zones, i, z)
                                mergedWithExisting := true
                                break
                if not mergedWithExisting
                    zoneBox = box.new(left=startBar, top=zoneTop, right=currentBar + 400, bottom=zoneBot, bgcolor=this.activeDemandCol, border_width=0)
                    zoneData = ZoneData.new(zoneBox, na, na, zoneTop, zoneBot, startBar, sess, 0, false, "Demand", false)
                    array.push(this.zones, zoneData)
                    this.lastDemandBar := currentBar
                    if array.size(this.zones) > this.maxZones * 4
                        array.shift(this.zones)

method updateZones(ZoneEngine this, int currentBar, float atrValue) =>
    if array.size(this.zones) > 0
        activeSupplyCount = 0
        activeDemandCount = 0
        historicSupplyCount = 0
        historicDemandCount = 0

        for i = 0 to array.size(this.zones) - 1
            z = array.get(this.zones, i)

            box.set_right(z.zoneBox, currentBar + 400)

            if not z.broken
                priceInZone = high >= z.bottom and low <= z.top
                if priceInZone and not z.retestCounted
                    z.retests += 1
                    z.retestCounted := true
                else if not priceInZone
                    z.retestCounted := false

            if not z.broken
                if z.zoneType == "Supply"
                    breakLevel = sd_invalidationMethod == "Close" ? close : high
                    if breakLevel > z.top
                        z.broken := true
                        box.set_bgcolor(z.zoneBox, sd_historicCol)
                else
                    breakLevel = sd_invalidationMethod == "Close" ? close : low
                    if breakLevel < z.bottom
                        z.broken := true
                        box.set_bgcolor(z.zoneBox, sd_historicCol)

            age = currentBar - z.startBar
            zoneHeight = z.top - z.bottom
            shouldHide = false

            if z.broken and not sd_showHistoric
                shouldHide := true

            if z.broken and age > sd_historicBars
                shouldHide := true
            if not z.broken and age > sd_activeLookback
                shouldHide := true

            if z.broken and sd_showHistoric
                if zoneHeight < atrValue * sd_minZoneHeightATR
                    shouldHide := true

                if z.zoneType == "Supply"
                    if historicSupplyCount >= sd_maxZones
                        shouldHide := true
                    else if not shouldHide
                        historicSupplyCount += 1
                else
                    if historicDemandCount >= sd_maxZones
                        shouldHide := true
                    else if not shouldHide
                        historicDemandCount += 1

            if not z.broken and not shouldHide
                if z.zoneType == "Supply"
                    if activeSupplyCount >= sd_maxZones
                        shouldHide := true
                    else
                        activeSupplyCount += 1
                else
                    if activeDemandCount >= sd_maxZones
                        shouldHide := true
                    else
                        activeDemandCount += 1

            if shouldHide
                z.hideVisuals()
            else
                if z.broken
                    z.setHistoricColor(sd_historicCol)
                else
                    zoneCol = z.zoneType == "Supply" ? sd_activeSupplyCol : sd_activeDemandCol
                    z.showZoneColor(zoneCol)

                showThisLabel = z.broken ? sd_showHistoricLabels : sd_showActiveLabels
                z.syncInfoLabel(showThisLabel)
                z.syncRetestLabel()

            array.set(this.zones, i, z)

float chart_hi = ta.highest(high, 300)
float chart_lo = ta.lowest(low, 300)
bool is_5m = timeframe.isminutes and timeframe.multiplier == 5
bool is_15m = timeframe.isminutes and timeframe.multiplier == 15
bool should_show_panel = show_htf_mini and (is_5m or is_15m)
float chart_range = math.max(chart_hi - chart_lo, syminfo.mintick * 100)
float panel_height = chart_range * 0.22
float panel_bottom = chart_hi + chart_range * 0.08
int x_anchor = bar_index + 7
int group_width = 9
int group_gap = 5
bool show_60 = should_show_panel and (is_5m or is_15m)
bool show_240 = should_show_panel and is_15m

[htf60_max, htf60_min, htf60_o1, htf60_h1, htf60_l1, htf60_c1, htf60_o2, htf60_h2, htf60_l2, htf60_c2, htf60_o3, htf60_h3, htf60_l3, htf60_c3] = request.security(syminfo.tickerid, "60", [
    ta.highest(high, 3),
    ta.lowest(low, 3),
    open[2],
    high[2],
    low[2],
    close[2],
    open[1],
    high[1],
    low[1],
    close[1],
    open,
    high,
    low,
    close
])

[htf240_max, htf240_min, htf240_o1, htf240_h1, htf240_l1, htf240_c1, htf240_o2, htf240_h2, htf240_l2, htf240_c2, htf240_o3, htf240_h3, htf240_l3, htf240_c3] = request.security(syminfo.tickerid, "240", [
    ta.highest(high, 3),
    ta.lowest(low, 3),
    open[2],
    high[2],
    low[2],
    close[2],
    open[1],
    high[1],
    low[1],
    close[1],
    open,
    high,
    low,
    close
])

bool htf60_low_sweep = not na(htf60_min) and low < htf60_min and close > htf60_min
bool htf60_high_sweep = not na(htf60_max) and high > htf60_max and close < htf60_max
bool htf240_low_sweep = not na(htf240_min) and low < htf240_min and close > htf240_min
bool htf240_high_sweep = not na(htf240_max) and high > htf240_max and close < htf240_max

if barstate.islast
    clear_htf_drawings()
    if show_60
        draw_tf_group("1H", x_anchor, htf60_max, htf60_min,
             htf60_o1, htf60_h1, htf60_l1, htf60_c1,
             htf60_o2, htf60_h2, htf60_l2, htf60_c2,
             htf60_o3, htf60_h3, htf60_l3, htf60_c3,
             htf60_low_sweep, htf60_high_sweep,
             panel_bottom, panel_height)
    if show_240
        draw_tf_group("4H", x_anchor + group_width + group_gap, htf240_max, htf240_min,
             htf240_o1, htf240_h1, htf240_l1, htf240_c1,
             htf240_o2, htf240_h2, htf240_l2, htf240_c2,
             htf240_o3, htf240_h3, htf240_l3, htf240_c3,
             htf240_low_sweep, htf240_high_sweep,
             panel_bottom, panel_height)

// --- Supply/Demand Main Logic ---
var engine = ZoneEngine.new()
if barstate.isfirst
    engine.init(sd_swingLen, sd_maxZones, sd_maxZoneHeightATR, sd_minZoneHeightATR, sd_forceZoneHeightATR, sd_minZoneDistance, sd_invalidationMethod, sd_showHistoric, sd_activeLookback, sd_historicBars, sd_showActiveLabels, sd_showHistoricLabels, sd_activeSupplyCol, sd_activeDemandCol, sd_historicCol, sd_showRetestMarkers, sd_retestBullCol, sd_retestBearCol)

sd_ph = ta.pivothigh(high, sd_swingLen, sd_swingLen)
sd_pl = ta.pivotlow(low, sd_swingLen, sd_swingLen)

if show_supply_demand
    sd_sessionNow = f_sdGetSession()
    if not na(sd_ph) and barstate.isconfirmed and sd_sessionNow != "Other"
        engine.createZone("Supply", high[sd_swingLen], low[sd_swingLen], bar_index - sd_swingLen, sd_sessionNow, atr, bar_index)
    if not na(sd_pl) and barstate.isconfirmed and sd_sessionNow != "Other"
        engine.createZone("Demand", high[sd_swingLen], low[sd_swingLen], bar_index - sd_swingLen, sd_sessionNow, atr, bar_index)
    engine.updateZones(bar_index, atr)

alertcondition(show_supply_demand and not na(sd_ph) and barstate.isconfirmed and sd_alertsOn, "New Supply Zone", "{{ticker}} - New Supply Zone @ {{close}}")
alertcondition(show_supply_demand and not na(sd_pl) and barstate.isconfirmed and sd_alertsOn, "New Demand Zone", "{{ticker}} - New Demand Zone @ {{close}}")

//=====================================================================================================================
// 13. ICT HP PRO INTEGRATION
//=====================================================================================================================

type slz_Point
    int x
    float y

type box_info
    box bx
    line ce_ln
    bool is_ifvg
    bool is_bull_orig

type htf_box_info
    box bx
    line ce_ln
    bool is_ifvg
    bool is_bull_orig
    float top
    float bot

type lvl_data
    float p
    string t_s
    string t_l
    color c
    bool eq

grp_slz = "[Smart Liquidity] Zones"
show_slz          = input.bool(true, "Show Smart Liquidity Zones", group = grp_slz)
slz_length        = input.int(5, "Swing Length", minval=1, tooltip="Number of bars used to confirm Swing Highs and Lows.", group = grp_slz)
slz_useClose      = input.bool(false, "Use Close for Breakout?", tooltip="If true, requires candle close to break structure. If false, uses wicks (High/Low).", group = grp_slz)
slz_reduceOverlap = input.bool(true, "Reduce Overlap (Strict Alternation)", tooltip="Forces Bullish and Bearish setups to alternate.", group = grp_slz)
slz_requireSweep  = input.bool(true, "Require Sweep (LL for Bull, HH for Bear)", tooltip="Ensures the origin of the break first made a Lower Low or Higher High before the MSS.", group = grp_slz)
