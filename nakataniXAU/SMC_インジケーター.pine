c_htfc_bear      = input.color(color.new(#f23645, 85), "HTF Bearish Color", group=grp_htf_candles)
c_htfc_wick      = input.color(color.new(color.gray, 60), "HTF Wick Color", group=grp_htf_candles)
htfc_border      = input.bool(true, "Show Candle Borders?", group=grp_htf_candles)

grp_levels      = "[ICT] HTF Levels Selection"
show_pd         = input.bool(true, "Show Daily High/Low", group=grp_levels)
